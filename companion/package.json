{
  "name": "krita-creative-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A macOS Krita creative assistant powered by Agent Pi",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node scripts/run-unit-tests.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "build:release": "python3 scripts/build-release.py",
    "test:packaging": "python3 -m unittest discover -s tests -p test_packaging.py",
    "test:unit": "node scripts/run-unit-tests.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@langfuse/client": "5.13.1",
    "@langfuse/otel": "5.13.1",
    "@langfuse/tracing": "5.13.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "pyodide": "314.0.7",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
