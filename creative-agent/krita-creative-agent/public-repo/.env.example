# Copy to .env in your paintings folder (the --project folder). All optional.

# Langfuse tracing: every chat becomes a Langfuse session. Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separates test traces from real work (default: development).
LANGFUSE_TRACING_ENVIRONMENT=development

# Fallback key for Luna decisions when OpenRouter is not connected in the panel.
OPENROUTER_API_KEY=

# Keys for the other built-in decision endpoints. A key saved in the panel wins over these.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
